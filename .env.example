# Configuração do Banco de Dados PostgreSQL (Local do Agent)
DATABASE_URL=postgresql+psycopg://usuario:senha@ip_do_banco:5432/nome_do_banco

# Configurações de Criptografia e Autenticação Interna do Agent
# Chave oficial e OBRIGATÓRIA para encriptação dos dados sensíveis no Banco (ex: tokens do Proxmox)
# (Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
AGENT_ENCRYPTION_KEY=sua_chave_fernet_segura_aqui

# Configurações de Autenticação JWT (Dashboard local)
JWT_SECRET_KEY=sua_chave_secreta_jwt_super_segura_aqui
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Conexão com o Cloud Control Plane
CLOUD_URL=http://192.168.0.200:8000
CLOUD_ENCRYPTION_KEY=sua_chave_de_criptografia_com_o_cloud

# -------------------------------------------------------------
# OBSOLETO / MIGRAÇÃO (NÃO NECESSÁRIO PARA NOVAS INSTALAÇÕES)
# -------------------------------------------------------------
# A API agora configura o Proxmox diretamente via Interface (Dashboard) e salva de forma criptografada no banco.
# Mantenha as variáveis abaixo APENAS se quiser fazer o bootstrap automático na primeira vez que subir o sistema.
# PROXMOX_HOST=192.168.0.100:8006
# PROXMOX_USER=root@pam
# PROXMOX_TOKEN_NAME=localAPI
# PROXMOX_TOKEN_VALUE=seu-token-uuid-gerado-no-proxmox
# PROXMOX_NODE=pve
# PROXMOX_DEFAULT_TEMPLATE=local:vztmpl/ubuntu-22.04-standard_22.04-1_amd64.tar.zst
# PROXMOX_DEFAULT_STORAGE=local-lvm
